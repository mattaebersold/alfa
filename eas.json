      }
    },
    "production": {
      "distribution": "store",
      "env": { "EAS_SKIP_AUTO_FINGERPRINT": "1" },
      "ios": {
        "autoIncrement": true
      },
      "android": {
        "autoIncrement": true
      }
    }
  },
