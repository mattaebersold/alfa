    "version": ">=19.0.5",
    "requireCommit": false,
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EAS_SKIP_AUTO_FINGERPRINT": "1" },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EAS_SKIP_AUTO_FINGERPRINT": "1" },
      "ios": {
        "simulator": false
      },
      "android": {
